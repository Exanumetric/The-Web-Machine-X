>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. THE-WEB-MACHINE-X-COBOL.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-SYSTEM-NAME PIC X(32) VALUE 'THE WEB MACHINE X'.
01 WS-VERSION PIC X(12) VALUE '0.3'.
01 WS-STATUS PIC X(12) VALUE 'CREATED'.
01 WS-OPERATION-COUNT PIC 9(8) VALUE ZERO.
01 WS-ERROR-COUNT PIC 9(8) VALUE ZERO.
01 WS-TEST-COUNT PIC 9(8) VALUE ZERO.
01 WS-TEST-PASS PIC 9(8) VALUE ZERO.
01 WS-TEST-FAIL PIC 9(8) VALUE ZERO.
01 WS-REQUEST-CODE PIC 9(4) VALUE ZERO.
01 WS-RESULT-CODE PIC 9 VALUE ZERO.
01 WS-REQUEST-NAME PIC X(40) VALUE SPACES.
01 WS-RESULT-MESSAGE PIC X(80) VALUE SPACES.
01 WS-STATE-NEW PIC X VALUE 'N'.
01 WS-STATE-READY PIC X VALUE 'R'.
01 WS-STATE-RUNNING PIC X VALUE 'A'.
01 WS-STATE-STOPPED PIC X VALUE 'S'.
01 WS-CONFIG-ENV PIC X(12) VALUE 'DEVELOPMENT'.
01 WS-CONFIG-STRICT PIC X(3) VALUE 'YES'.
01 WS-CONFIG-MAX-REQUESTS PIC 9(5) VALUE 10000.
01 WS-CONFIG-TIMEOUT PIC 9(4) VALUE 30.
01 WS-RECORD-KEY PIC X(20) VALUE SPACES.
01 WS-RECORD-VALUE PIC X(80) VALUE SPACES.
01 WS-RECORD-LOCKED PIC X VALUE 'N'.
01 WS-OBJECT-TYPE PIC X(16) VALUE SPACES.
01 WS-OBJECT-ACTION PIC X(16) VALUE SPACES.
01 WS-OBJECT-RESULT PIC X(80) VALUE SPACES.
01 WS-EXPECTED PIC X(80) VALUE SPACES.
01 WS-ACTUAL PIC X(80) VALUE SPACES.
01 WS-IDX PIC 9(4) COMP-5 VALUE ZERO.
PROCEDURE DIVISION.
MAIN-CONTROLLER.
    PERFORM SYSTEM-INITIALIZE
    PERFORM CONFIGURATION-LOAD
    PERFORM ENUMERATOR-SELF-CHECK
    PERFORM OBJECT-MODEL-SELF-CHECK
    PERFORM SERVICE-CATALOG
    PERFORM TEST-SUITE
    PERFORM SYSTEM-SHUTDOWN
    STOP RUN.
SYSTEM-INITIALIZE.
    MOVE WS-STATE-READY TO WS-STATUS
    DISPLAY '========================================'
    DISPLAY WS-SYSTEM-NAME
    DISPLAY 'COBOL SYSTEM VERSION ' WS-VERSION
    DISPLAY '========================================'
    ADD 1 TO WS-OPERATION-COUNT.
CONFIGURATION-LOAD.
    IF WS-CONFIG-ENV = SPACES
        MOVE 'DEVELOPMENT' TO WS-CONFIG-ENV
    END-IF
    IF WS-CONFIG-MAX-REQUESTS = ZERO
        MOVE 10000 TO WS-CONFIG-MAX-REQUESTS
    END-IF
    IF WS-CONFIG-TIMEOUT = ZERO
        MOVE 30 TO WS-CONFIG-TIMEOUT
    END-IF
    DISPLAY 'CONFIGURATION: ' WS-CONFIG-ENV
    ADD 1 TO WS-OPERATION-COUNT.
ENUMERATOR-SELF-CHECK.
    IF WS-STATE-NEW = WS-STATE-READY
        ADD 1 TO WS-ERROR-COUNT
    END-IF
    IF WS-STATE-STOPPED = WS-STATE-RUNNING
        ADD 1 TO WS-ERROR-COUNT
    END-IF
    ADD 1 TO WS-OPERATION-COUNT.
OBJECT-MODEL-SELF-CHECK.
    MOVE 'BASE-SERVICE' TO WS-OBJECT-TYPE
    MOVE 'INITIALIZE' TO WS-OBJECT-ACTION
    PERFORM OBJECT-DISPATCH
    MOVE 'CACHE-SERVICE' TO WS-OBJECT-TYPE
    PERFORM OBJECT-DISPATCH
    MOVE 'FILE-SERVICE' TO WS-OBJECT-TYPE
    PERFORM OBJECT-DISPATCH.
OBJECT-DISPATCH.
    EVALUATE WS-OBJECT-TYPE
        WHEN 'BASE-SERVICE'
            PERFORM BASE-SERVICE-INITIALIZE
        WHEN 'CACHE-SERVICE'
            PERFORM CACHE-SERVICE-INITIALIZE
        WHEN 'FILE-SERVICE'
            PERFORM FILE-SERVICE-INITIALIZE
        WHEN OTHER
            MOVE 'UNKNOWN OBJECT TYPE' TO WS-OBJECT-RESULT
            ADD 1 TO WS-ERROR-COUNT
    END-EVALUATE
    ADD 1 TO WS-OPERATION-COUNT.
BASE-SERVICE-INITIALIZE.
    MOVE 'BASE SERVICE READY' TO WS-OBJECT-RESULT.
CACHE-SERVICE-INITIALIZE.
    MOVE 'CACHE SERVICE READY' TO WS-OBJECT-RESULT.
FILE-SERVICE-INITIALIZE.
    MOVE 'FILE SERVICE READY' TO WS-OBJECT-RESULT.
SERVICE-CATALOG.
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > 120
        PERFORM SERVICE-ROUTER
    END-PERFORM.
SERVICE-ROUTER.
    EVALUATE WS-IDX
        WHEN 1 PERFORM SERVICE-001
        WHEN 2 PERFORM SERVICE-002
        WHEN 3 PERFORM SERVICE-003
        WHEN 4 PERFORM SERVICE-004
        WHEN 5 PERFORM SERVICE-005
        WHEN OTHER MOVE 'CATALOG SERVICE' TO WS-RESULT-MESSAGE
    END-EVALUATE
    ADD 1 TO WS-OPERATION-COUNT.
RECORD-API-READ.
    IF WS-RECORD-LOCKED = 'Y'
        MOVE 'RECORD LOCKED' TO WS-RESULT-MESSAGE
        MOVE 1 TO WS-RESULT-CODE
    ELSE
        MOVE WS-RECORD-VALUE TO WS-ACTUAL
        MOVE 0 TO WS-RESULT-CODE
    END-IF.
RECORD-API-WRITE.
    IF WS-RECORD-LOCKED = 'Y'
        MOVE 'RECORD LOCKED' TO WS-RESULT-MESSAGE
        MOVE 1 TO WS-RESULT-CODE
    ELSE
        MOVE WS-ACTUAL TO WS-RECORD-VALUE
        MOVE 0 TO WS-RESULT-CODE
    END-IF.
RECORD-API-LOCK.
    MOVE 'Y' TO WS-RECORD-LOCKED.
RECORD-API-UNLOCK.
    MOVE 'N' TO WS-RECORD-LOCKED.
TEST-SUITE.
    PERFORM TEST-CONFIGURATION
    PERFORM TEST-ENUMERATORS
    PERFORM TEST-OBJECT-DISPATCH
    PERFORM TEST-ENCAPSULATION
    DISPLAY 'TESTS: ' WS-TEST-COUNT
    DISPLAY 'PASSED: ' WS-TEST-PASS
    DISPLAY 'FAILED: ' WS-TEST-FAIL.
TEST-CONFIGURATION.
    MOVE 'DEVELOPMENT' TO WS-EXPECTED
    MOVE WS-CONFIG-ENV TO WS-ACTUAL
    PERFORM ASSERT-EQUAL.
TEST-ENUMERATORS.
    MOVE 'R' TO WS-EXPECTED
    MOVE WS-STATE-READY TO WS-ACTUAL
    PERFORM ASSERT-EQUAL.
TEST-OBJECT-DISPATCH.
    MOVE 'BASE-SERVICE' TO WS-OBJECT-TYPE
    PERFORM OBJECT-DISPATCH
    MOVE 'BASE SERVICE READY' TO WS-EXPECTED
    MOVE WS-OBJECT-RESULT TO WS-ACTUAL
    PERFORM ASSERT-EQUAL.
TEST-ENCAPSULATION.
    MOVE 'TEST VALUE' TO WS-ACTUAL
    PERFORM RECORD-API-WRITE
    PERFORM RECORD-API-READ
    MOVE 'TEST VALUE' TO WS-EXPECTED
    PERFORM ASSERT-EQUAL.
ASSERT-EQUAL.
    ADD 1 TO WS-TEST-COUNT
    IF WS-EXPECTED = WS-ACTUAL
        ADD 1 TO WS-TEST-PASS
    ELSE
        ADD 1 TO WS-TEST-FAIL
        DISPLAY 'ASSERTION FAILED'
    END-IF.
SYSTEM-SHUTDOWN.
    MOVE WS-STATE-STOPPED TO WS-STATUS
    DISPLAY 'SYSTEM STATUS: ' WS-STATUS
    DISPLAY 'OPERATIONS: ' WS-OPERATION-COUNT
    DISPLAY 'ERRORS: ' WS-ERROR-COUNT
    DISPLAY 'SYSTEM SHUTDOWN COMPLETE'.
SERVICE-001.
    MOVE 'SERVICE-001' TO WS-REQUEST-NAME
    MOVE 0001 TO WS-REQUEST-CODE
    MOVE 0 TO WS-RESULT-CODE
    MOVE 'SERVICE 001 COMPLETED' TO WS-RESULT-MESSAGE
    IF WS-CONFIG-STRICT NOT = 'YES'
        MOVE 'RELAXED SERVICE MODE' TO WS-RESULT-MESSAGE
    END-IF
    ADD 1 TO WS-OPERATION-COUNT.
